# ==============================================================================
# BrandProof — Environment Configuration Template
# NOTE: Use this file as a template. Never commit actual secrets or production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database (Render Managed PostgreSQL or Docker Compose)
# In production on Render: use the DATABASE_URL provided by Render PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_USER=brandproof
POSTGRES_PASSWORD=replace-with-secure-local-password
POSTGRES_DB=brandproof
DATABASE_URL=sqlite:///./brandproof.db
# Production Render example: postgresql://username:password@dpg-xxxx.render.com/brandproof_db

# ------------------------------------------------------------------------------
# Backend Application & Security
# ------------------------------------------------------------------------------
PROJECT_NAME="BrandProof Brand Governance Platform"
ENVIRONMENT=development
DEBUG=true

# JWT Secret: In production, generate using: openssl rand -hex 32
SECRET_KEY=replace-with-cryptographically-secure-random-32-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Controlled Demo Mode (Must be false in production)
ENABLE_DEMO_RESET=false
ENABLE_DEMO_MODE=false

# ------------------------------------------------------------------------------
# Storage Configuration
# Local storage for development/testing: STORAGE_BACKEND=local
# S3 / Cloudflare R2 / AWS S3 for production: STORAGE_BACKEND=s3
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_DIR=./storage_data

# Required only if STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_BUCKET_NAME=brandproof-documents
S3_ACCESS_KEY=your-s3-access-key-id
S3_SECRET_KEY=your-s3-secret-access-key
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# CORS Origins (Comma-separated list or JSON array of authorized frontend domains)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Frontend Configuration (Used by Next.js client)
# In production on Vercel: configure NEXT_PUBLIC_API_URL to point to Render backend
# Example: https://brandproof-backend.onrender.com/api/v1
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
