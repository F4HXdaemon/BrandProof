# ==============================================================================
# BrandProof Backend Environment Configuration Template
# ==============================================================================

PROJECT_NAME="BrandProof Brand Governance Platform"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL for Render / Docker; SQLite for zero-dependency local dev)
DATABASE_URL="sqlite:///./brandproof.db"
# Production Render example: postgresql://username:password@dpg-xxxx.render.com/brandproof_db

# Security: In production, generate a 256-bit random key: openssl rand -hex 32
SECRET_KEY="replace-with-cryptographically-secure-random-32-char-string-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo Mode Settings (Must remain false in production)
ENABLE_DEMO_RESET=false
ENABLE_DEMO_MODE=false

# Object Storage Backend ("local" for local development, "s3" for production)
STORAGE_BACKEND="local"
STORAGE_DIR="./storage_data"

# S3 Compatible Storage (Required when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=""
S3_BUCKET_NAME="brandproof-documents"
S3_ACCESS_KEY="your-s3-access-key-id"
S3_SECRET_KEY="your-s3-secret-access-key"
S3_REGION="us-east-1"

# CORS Configuration (Comma-separated origins or JSON array)
# Production example: https://brandproof.vercel.app,https://brandproof-staging.vercel.app
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
