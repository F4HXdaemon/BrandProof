# ==============================================================================
# BrandProof Backend Environment Configuration Template
# ==============================================================================

PROJECT_NAME="BrandProof Brand Governance Platform"
ENVIRONMENT="development"
DEBUG=true

# Database (Neon PostgreSQL for Persistent Cloud Production; SQLite for Zero-Dependency Local Dev)
#
# Neon Pooled Connection (Used by FastAPI runtime for pooled query execution via PgBouncer):
# DATABASE_URL="postgresql://user:password@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/brandproof?sslmode=require"
#
# Neon Direct Unpooled Connection (Used by Alembic migrations for DDL execution):
# DIRECT_DATABASE_URL="postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/brandproof?sslmode=require"
#
# Local SQLite fallback for offline dev/test:
DATABASE_URL="sqlite:///./brandproof.db"

# Database Connection Pooling Options (Tuned for Serverless PgBouncer / Neon)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30

# Security: In production, generate a 256-bit random key: openssl rand -hex 32
SECRET_KEY="replace-with-cryptographically-secure-random-32-char-string-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo Mode Settings (Must remain false in production)
ENABLE_DEMO_RESET=false
ENABLE_DEMO_MODE=false

# Object Storage Backend ("local" for local development, "s3" for production)
STORAGE_BACKEND="local"
STORAGE_DIR="./storage_data"

# S3 Compatible Storage (Required when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=""
S3_BUCKET_NAME="brandproof-documents"
S3_ACCESS_KEY="your-s3-access-key-id"
S3_SECRET_KEY="your-s3-secret-access-key"
S3_REGION="us-east-1"

# CORS Configuration (Comma-separated origins or JSON array)
# Production example: https://brand-proof-chi.vercel.app,http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
