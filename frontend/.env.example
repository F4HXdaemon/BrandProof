# ==============================================================================
# BrandProof Frontend Environment Configuration Template
# ==============================================================================

# Backend API base URL including the /api/v1 prefix
# Local development: http://localhost:8000/api/v1
# Production (Render): https://YOUR-RENDER-BACKEND-SERVICE.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Enable/disable demonstration mode persona switcher and demo fixtures
# Set to false for standard customer deployments
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
